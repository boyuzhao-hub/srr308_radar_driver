ARG ROS2_DIST=humble
ARG IMAGE_NAME=ros:${ROS2_DIST}-ros-base-jammy

FROM ${IMAGE_NAME}

SHELL ["/bin/bash", "-c"]

ARG ROS2_DIST=humble
ARG ROS_WS=/root/ros2_ws

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=${ROS2_DIST} \
    ROS_WS=${ROS_WS} \
    RADAR_SOURCE_DIR=${ROS_WS}/src/srr308_radar_driver \
    RADAR_COLCON_BASE_PATHS=${ROS_WS}/src/srr308_radar_driver/src \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    ROS_DOMAIN_ID=0 \
    AUTO_BUILD=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bash-completion \
      build-essential \
      can-utils \
      cmake \
      git \
      iproute2 \
      less \
      nano \
      net-tools \
      python3-colcon-common-extensions \
      python3-numpy \
      python3-opencv \
      python3-pip \
      python3-rosdep \
      python3-scipy \
      python3-vcstool \
      ros-${ROS2_DIST}-nav2-common \
      ros-${ROS2_DIST}-nav2-lifecycle-manager \
      ros-${ROS2_DIST}-rmw-cyclonedds-cpp \
      sudo \
      udev \
      usbutils \
      wget && \
    rm -rf /var/lib/apt/lists/*

WORKDIR ${RADAR_SOURCE_DIR}
COPY . ./

WORKDIR ${ROS_WS}

RUN apt-get update && \
    rosdep init 2>/dev/null || true && \
    rosdep update && \
    source "/opt/ros/${ROS_DISTRO}/setup.bash" && \
    rosdep install -y -r -q --from-paths "${RADAR_COLCON_BASE_PATHS}" --ignore-src --rosdistro "${ROS_DISTRO}" && \
    rm -rf /var/lib/apt/lists/*

RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" && \
    colcon build \
      --symlink-install \
      --base-paths "${RADAR_COLCON_BASE_PATHS}" \
      --event-handlers console_direct+ \
      --cmake-args -DCMAKE_BUILD_TYPE=Release && \
    rm -rf build log

COPY docker/entrypoint.sh /sbin/ros_entrypoint.sh
RUN chmod 755 /sbin/ros_entrypoint.sh

WORKDIR ${ROS_WS}

ENTRYPOINT ["/sbin/ros_entrypoint.sh"]
CMD ["bash"]
